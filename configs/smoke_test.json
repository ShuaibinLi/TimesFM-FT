{
  "data": {
    "train_path": "data/dummy/single/train.npz",
    "val_path": "data/dummy/single/val.npz",
    "context_length": 32,
    "horizon_length": 16,
    "max_variates": 1
  },
  "model": {
    "checkpoint": "google/timesfm-3.0-pytorch",
    "tuning_mode": "head",
    "last_n_layers": 1,
    "lora_rank": 4,
    "lora_alpha": 8.0,
    "lora_dropout": 0.0,
    "disable_linear_detrending": false
  },
  "loss": {
    "tick_size": 0.01,
    "pinball_weight": 1.0,
    "median_huber_weight": 0.5,
    "crossing_weight": 0.05,
    "huber_delta_ticks": 1.0
  },
  "train": {
    "output_dir": "outputs/smoke-test",
    "epochs": 1,
    "batch_size": 1,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "warmup_ratio": 0.0,
    "max_grad_norm": 1.0,
    "num_workers": 0,
    "gradient_accumulation_steps": 1,
    "seed": 42,
    "device": "mps",
    "dtype": "float32"
  }
}
