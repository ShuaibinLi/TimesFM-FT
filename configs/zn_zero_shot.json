    "alpha": 1.0,
    "dropout": 0.0
  },
  "objective": {
    "tick_size": 0.015625
  },
  "trainer": {
    "output_dir": "outputs/zn-zero-shot-c256-h64",
    "epochs": 1,
    "batch_size": 32,
    "num_workers": 0,
